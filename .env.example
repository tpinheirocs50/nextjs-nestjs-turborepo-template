# ============================================================
# Environment variables for `pnpm docker:up` / `docker compose`
# ============================================================
# Copy this file to .env (gitignored) and fill in real values.
# This file is the canonical source of "what env vars does the
# Docker stack need?". Per-app .env files (apps/api/.env,
# apps/web/.env) are used for local pnpm dev workflows only.

# ---- Required ----

# Better Auth: signing secret for sessions and cookie cache.
# Must be at least 32 characters. Must match across api and web.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# ---- Required for docker-compose.prod.yml (public deployment) ----
# Not used by the default docker-compose.yml local stack. Copy this file
# to .env on the deployment host and replace the example.com placeholders
# with your real domains.

# Public URL of the web app (the origin users visit in the browser).
# Used as the api's CORS allowed origin.
PUBLIC_WEB_URL=

# Public URL of the api. Baked into the web image at build time
# (NEXT_PUBLIC_API_URL) and used as the api's BETTER_AUTH_URL.
PUBLIC_API_URL=

# Parent domain for the session cookie, with a leading dot, so the
# cookie set by the api (api.example.com) is readable by the web app
# (app.example.com). Must cover both hostnames above.
COOKIE_DOMAIN=

# ---- Optional: external database ----
# Leave unset to use the postgres container bundled with the stack.
# Set only to point the api/migrations at an external database. The URL
# is resolved from inside the containers, so `localhost` will not work.
# DATABASE_URL=

# ---- Optional: Google OAuth ----
# Leave unset to disable Google sign-in. To enable, register an
# OAuth app at https://console.cloud.google.com/ and paste the
# values here. See README "Google OAuth setup" for details.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Optional: GitHub OAuth ----
# Leave unset to disable GitHub sign-in. To enable, register an
# OAuth app at https://github.com/settings/developers and paste
# the values here. See README "GitHub OAuth setup" for details.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Resend — transactional email (optional)
# Without these, email verification is disabled in the Docker stack.
# See README "Email setup (Resend)".
RESEND_API_KEY=
EMAIL_FROM=
